{
  "name": "vane-shopping-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --env-file-if-exists=.env --test test/*.test.mjs",
    "test:unit": "node --test test/pricing.test.mjs",
    "check": "npm run verify:vendor && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@lilka/vane": "file:vendor/lilka-vane-0.1.0-rc.1.tgz",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3"
  }
}
